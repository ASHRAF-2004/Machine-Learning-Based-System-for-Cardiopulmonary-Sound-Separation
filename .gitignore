# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# =========================
# Environment files
# =========================
.env
*.env

# Keep example env files if you create them
!.env.example

# =========================
# SQLite runtime database
# =========================
database/*.db
database/*.db-journal
database/*.sqlite
database/*.sqlite3

# Keep SQL schema and seed files
!database/schema.sql
!database/seed.sql

# =========================
# Runtime storage
# =========================
storage/uploads/*
storage/outputs/*
storage/logs/*
storage/**/*.log

# Keep folder placeholders
!storage/uploads/
!storage/uploads/raw/
!storage/uploads/temp/
!storage/uploads/raw/.gitkeep
!storage/uploads/temp/.gitkeep
!storage/outputs/
!storage/outputs/heart/
!storage/outputs/lung/
!storage/outputs/heart/.gitkeep
!storage/outputs/lung/.gitkeep
!storage/logs/
!storage/logs/.gitkeep

# =========================
# ML model weights
# =========================
storage/ml_models/*.pt
storage/ml_models/*.pth
storage/ml_models/*.onnx
storage/ml_models/*.ckpt

# Keep model folder placeholder and small config if needed
!storage/ml_models/
!storage/ml_models/.gitkeep
!storage/ml_models/model.yaml

# =========================
# Datasets
# =========================
datasets/*

# Keep dataset folder placeholder only
!datasets/
!datasets/.gitkeep

# =========================
# Research paper source files
# =========================
# Keep research PDFs/local references out of GitHub unless your group explicitly wants to publish them.
docs/Papers/
docs/Referances/

# =========================
# External cloned repositories and local tools
# =========================
external/
tools/
*.jar

# =========================
# Node / Mermaid local artifacts
# =========================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =========================
# LaTeX build files
# =========================
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*.lol
*.nav
*.snm
*.vrb

# Keep final/report PDFs only if you want to commit them manually
# Uncomment the next line if you do NOT want PDFs committed
# *.pdf

# =========================
# OS junk
# =========================
.DS_Store
._*
Thumbs.db
desktop.ini
__MACOSX/

# =========================
# IDE/editor
# =========================
.vscode/
.idea/

# =========================
# Temporary files
# =========================
*.tmp
*.bak
*.old
tree.txt
neossnet_tree.txt
