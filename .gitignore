# =========================
# Python
# =========================
__pycache__/
**/__pycache__/
*.py[cod]
*.pyc
*.pyo
*.pyd
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/

# =========================
# Environment files
# =========================
.env
*.env

# Keep example env files if you create them
!.env.example

# =========================
# SQLite runtime database
# =========================
database/*.db
database/*.db-journal
database/*.sqlite
database/*.sqlite3

# Keep SQL schema and seed files
!database/schema.sql
!database/seed.sql

# =========================
# Runtime storage
# =========================
storage/uploads/*
storage/uploads/raw/*
storage/uploads/temp/*
storage/outputs/*
storage/outputs/heart/*
storage/outputs/lung/*
storage/logs/*
storage/**/*.log

# Keep folder placeholders
!storage/uploads/
!storage/uploads/raw/
!storage/uploads/temp/
!storage/uploads/raw/.gitkeep
!storage/uploads/temp/.gitkeep
!storage/outputs/
!storage/outputs/heart/
!storage/outputs/lung/
!storage/outputs/heart/.gitkeep
!storage/outputs/lung/.gitkeep
!storage/logs/
!storage/logs/.gitkeep

# =========================
# ML model weights
# =========================
storage/ml_models/*.pt
storage/ml_models/*.pth
storage/ml_models/*.onnx
storage/ml_models/*.ckpt

# Keep model folder placeholder and small config if needed
!storage/ml_models/
!storage/ml_models/.gitkeep
!storage/ml_models/model.yaml
!storage/ml_models/model_best.pt

