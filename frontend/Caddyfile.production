{
	admin off
	auto_https off
}

:8080 {
	root * /srv
	encode zstd gzip

	@backend path /api /api/* /health /static/*
	handle @backend {
		reverse_proxy api:8000
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
}
