# Live is the default. Demo is allowed ONLY by npm run dev:demo or explicit
# VITE_APP_MODE=demo in a Vite development server; production never enables it.
VITE_APP_MODE=live
# The public origin is centralized in src/config/runtime.ts.
# Public web-app configuration, to be copied from the EXISTING selected app.
# These are not Admin SDK credentials. Do not put service account secrets here.
VITE_FIREBASE_PROJECT_ID=stethofuse-c18cd-3cca0
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
# API destinations are fixed to same-origin /api. Optional dev proxy is loopback.
STETHOFUSE_API_PROXY=http://127.0.0.1:8000
# Firebase SDK uses browser-session persistence (not long-lived local persistence).
# This survives reload in this tab. JS-accessible SDK session state is still exposed
# to XSS; do not claim HttpOnly protection or persist tokens manually.
