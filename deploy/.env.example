# Copy to an external, owner-only environment file (do not commit the copy).
# Persistent runtime data must not be inside the web root or a public volume.
STETHOFUSE_RUNTIME_ROOT=/srv/stethofuse
STETHOFUSE_API_UID=10001
STETHOFUSE_API_GID=10001
STETHOFUSE_BIND_ADDRESS=127.0.0.1
STETHOFUSE_HTTP_PORT=8088
STETHOFUSE_FIREBASE_ENABLED=0

# Public Firebase Web App configuration only; these values ship to browsers.
# Read them from the already-selected StethoFuse Firebase Web App.
VITE_FIREBASE_PROJECT_ID=stethofuse-c18cd-3cca0
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=

# Required only with compose.firebase.yaml; keep the actual ADC file elsewhere.
STETHOFUSE_ADC_FILE=/etc/stethofuse/application-default-credentials.json
