# Copy outside the repository to /etc/stethofuse/backup.env (root:root 0600).
# Fill only after a private B2 bucket and bucket-scoped S3 key are approved.
STETHOFUSE_RUNTIME_ROOT=/srv/stethofuse
STETHOFUSE_RUNTIME_ENV_FILE=/etc/stethofuse/runtime.env
STETHOFUSE_DEPLOY_DIR=/opt/stethofuse/deploy

# Backblaze's S3-compatible endpoint format. Keep the real bucket/endpoint in
# the root-only server file. Do not paste credentials into this template.
# RESTIC_PASSWORD_FILE is supplied as a private systemd credential by the unit.
RESTIC_REPOSITORY=
RESTIC_CACHE_DIR=/var/cache/stethofuse-restic
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
