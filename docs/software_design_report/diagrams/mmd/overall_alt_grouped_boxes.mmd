flowchart LR
    request["Separation Request<br/>audio_id + optional model_id"]

    subgraph facade["Facade Pattern"]
        service["SeparationService<br/><<Facade>><br/>one workflow call"]
    end

    subgraph factory["Factory Method Pattern"]
        model["ModelService<br/>selected/default model"]
        creator["SeparationAlgorithmFactory<br/><<Creator>><br/>create(model)"]
    end

    subgraph strategy["Strategy Pattern"]
        product["SeparationAlgorithm<br/><<Strategy/Product>>"]
        concrete["NeoSSNetStrategy<br/><<ConcreteStrategy>>"]
    end

    outputs["Heart and Lung WAV Outputs"]

    request --> service
    service --> model
    model --> creator
    service --> creator
    creator --> product
    creator --> concrete
    concrete -. implements .-> product
    service --> product
    product --> outputs

    style facade fill:#dcecff,stroke:#2f5f98,stroke-width:2px
    style factory fill:#e4f7e7,stroke:#3d7c49,stroke-width:2px
    style strategy fill:#fff1cc,stroke:#a66a00,stroke-width:2px
    classDef neutral fill:#ffffff,stroke:#2f3a4a,color:#1f2933
    class request,outputs neutral
