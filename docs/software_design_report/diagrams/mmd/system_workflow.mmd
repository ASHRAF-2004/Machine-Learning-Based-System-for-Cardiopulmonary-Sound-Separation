flowchart TB
  Start([User opens HealthTech web system])
  SelectFile["Select mixed cardiopulmonary WAV file"]
  Upload["Submit upload through browser"]
  Validate{"FastAPI validates WAV<br/>type, size, and readability"}
  Reject["Reject upload<br/>show validation message<br/>write system_log"]
  SaveUpload["Save file to<br/>storage/uploads/raw"]
  InsertUpload["Insert uploaded_audio metadata<br/>into SQLite"]
  ShowReady["Show uploaded file<br/>ready for separation"]

  CreateJob["Create separation_job<br/>status: queued"]
  MarkRunning["Update job status<br/>running"]
  LoadModel["Load active NeoSSNet model<br/>from storage/ml_models"]
  Preprocess["Preprocess uploaded waveform<br/>using inference settings"]
  Infer["Run NeoSSNet inference<br/>heart and lung separation"]
  SaveOutputs["Save separated WAV files<br/>heart and lung outputs"]
  RecordResult["Insert separation_result<br/>with output file paths"]
  RecordMetrics["Store evaluation_metric rows<br/>when references are available"]
  CompleteJob["Update separation_job<br/>completed"]

  Failure{"Processing error?"}
  MarkFailed["Update separation_job<br/>failed with error_message<br/>write system_log"]

  ResultView["Browser requests result/history"]
  ReadResult["FastAPI reads SQLite metadata<br/>and resolves local file paths"]
  PreviewDownload["User previews original, heart, and lung audio<br/>then downloads outputs"]
  End([Demo-ready result is available])

  Start --> SelectFile --> Upload --> Validate
  Validate -- "No" --> Reject --> Start
  Validate -- "Yes" --> SaveUpload --> InsertUpload --> ShowReady
  ShowReady --> CreateJob --> MarkRunning --> LoadModel --> Preprocess --> Infer --> Failure
  Failure -- "Yes" --> MarkFailed --> ResultView
  Failure -- "No" --> SaveOutputs --> RecordResult --> RecordMetrics --> CompleteJob --> ResultView
  ResultView --> ReadResult --> PreviewDownload --> End

  classDef start fill:#eef7ff,stroke:#2563eb,stroke-width:1px,color:#0f172a
  classDef decision fill:#fff7ed,stroke:#ea580c,stroke-width:1px,color:#0f172a
  classDef process fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#0f172a
  classDef data fill:#fefce8,stroke:#ca8a04,stroke-width:1px,color:#0f172a
  classDef success fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#0f172a
  classDef error fill:#fef2f2,stroke:#dc2626,stroke-width:1px,color:#0f172a

  class Start,End start
  class Validate,Failure decision
  class SelectFile,Upload,ShowReady,CreateJob,MarkRunning,LoadModel,Preprocess,Infer,SaveOutputs,ResultView,ReadResult,PreviewDownload process
  class SaveUpload,InsertUpload,RecordResult,RecordMetrics data
  class CompleteJob success
  class Reject,MarkFailed error
