flowchart LR
  User(["User<br/>Student, lecturer, researcher"])

  subgraph Browser["Browser UI<br/>HTML / CSS / JavaScript"]
    UploadPage["Upload mixed WAV"]
    ResultPage["Preview results<br/>Download outputs<br/>View history"]
  end

  subgraph FastAPI["FastAPI Application"]
    UploadRouter["Upload Router<br/>POST /upload"]
    SeparationRouter["Separation Router<br/>POST /separate/{audio_id}"]
    ResultRouter["Result Router<br/>GET /result/{job_id}<br/>GET /download/{job_id}/{type}<br/>GET /history"]
  end

  subgraph Services["Service Layer"]
    StorageService["StorageService<br/>file save and lookup"]
    SeparationService["SeparationService<br/>coordinates separation job"]
    ResultService["ResultService<br/>history, result, download access"]
  end

  subgraph ML["ML Layer"]
    AudioPreprocessor["AudioPreprocessor<br/>load and prepare waveform"]
    NeoSSNet["NeoSSNet Inference<br/>PyTorch model"]
  end

  subgraph SQLite["SQLite Database<br/>database/cardiopulmonary.db"]
    UploadedAudio[("uploaded_audio")]
    Model[("model")]
    SeparationJob[("separation_job")]
    SeparationResult[("separation_result")]
    EvaluationMetric[("evaluation_metric")]
    SystemLog[("system_log")]
  end

  subgraph Storage["Local Storage"]
    Uploads[("storage/uploads/raw<br/>mixed WAV uploads")]
    HeartOutputs[("storage/outputs/heart<br/>heart WAV outputs")]
    LungOutputs[("storage/outputs/lung<br/>lung WAV outputs")]
    ModelFiles[("storage/ml_models<br/>NeoSSNet checkpoints")]
    LogFiles[("storage/logs<br/>optional log files")]
  end

  subgraph Dataset["HLS-CMDS Dataset Storage<br/>not used as runtime upload storage"]
    RawDataset[("datasets/hls_cmds/raw<br/>HS, LS, Mix")]
    ProcessedDataset[("datasets/hls_cmds/processed<br/>train, val, test")]
    MetadataDataset[("datasets/hls_cmds/metadata")]
  end

  User --> UploadPage
  User --> ResultPage

  UploadPage -->|"mixed WAV upload"| UploadRouter
  ResultPage -->|"start separation"| SeparationRouter
  ResultPage -->|"preview, download, history"| ResultRouter

  UploadRouter --> StorageService
  UploadRouter -->|"insert upload metadata"| UploadedAudio

  SeparationRouter --> SeparationService
  SeparationService --> StorageService
  SeparationService --> AudioPreprocessor
  SeparationService --> NeoSSNet
  SeparationService -->|"create and update job"| SeparationJob
  SeparationService -->|"read active model"| Model
  SeparationService -->|"write result paths"| SeparationResult
  SeparationService -->|"write metrics"| EvaluationMetric
  SeparationService -->|"write events"| SystemLog

  ResultRouter --> ResultService
  ResultService -->|"read result and history"| SQLite
  ResultService -->|"resolve audio files"| Storage

  StorageService -->|"save upload"| Uploads
  StorageService -->|"save heart output"| HeartOutputs
  StorageService -->|"save lung output"| LungOutputs
  AudioPreprocessor -->|"read mixed WAV"| Uploads
  NeoSSNet -->|"load checkpoint/config"| ModelFiles
  SystemLog -.-> LogFiles

  RawDataset -.->|"training source"| ML
  ProcessedDataset -.->|"training/evaluation source"| ML
  MetadataDataset -.->|"dataset metadata"| ML

  classDef actor fill:#eef7ff,stroke:#2563eb,stroke-width:1px,color:#0f172a
  classDef ui fill:#f8fafc,stroke:#64748b,stroke-width:1px,color:#0f172a
  classDef api fill:#ecfeff,stroke:#0891b2,stroke-width:1px,color:#0f172a
  classDef service fill:#f0fdf4,stroke:#16a34a,stroke-width:1px,color:#0f172a
  classDef ml fill:#fff7ed,stroke:#ea580c,stroke-width:1px,color:#0f172a
  classDef data fill:#fefce8,stroke:#ca8a04,stroke-width:1px,color:#0f172a
  classDef storage fill:#faf5ff,stroke:#9333ea,stroke-width:1px,color:#0f172a

  class User actor
  class UploadPage,ResultPage ui
  class UploadRouter,SeparationRouter,ResultRouter api
  class StorageService,SeparationService,ResultService service
  class AudioPreprocessor,NeoSSNet ml
  class UploadedAudio,Model,SeparationJob,SeparationResult,EvaluationMetric,SystemLog data
  class Uploads,HeartOutputs,LungOutputs,ModelFiles,LogFiles,RawDataset,ProcessedDataset,MetadataDataset storage
