@startuml
' Architecture diagram.
' Suggested LaTeX placement: landscape page for readability.

skinparam rectangle {
  BackgroundColor #F8FBFF
  BorderColor #2D5A88
}
skinparam database {
  BackgroundColor #FFF8E8
  BorderColor #8A6A1F
}
skinparam folder {
  BackgroundColor #F3FFF4
  BorderColor #2E7D32
}
skinparam shadowing false
left to right direction

actor "User" as User

rectangle "Browser UI\nHTML / CSS / JavaScript" as Browser

rectangle "FastAPI Application" as FastAPI {
  rectangle "Upload Router\nPOST /upload" as UploadRouter
  rectangle "Separation Router\nPOST /separate/{audio_id}" as SeparationRouter
  rectangle "Results Router\nGET /result/{job_id}\nGET /download/{job_id}/{type}\nGET /history" as ResultRouter
}

rectangle "Service Layer" as Services {
  rectangle "StorageService" as StorageService
  rectangle "SeparationService" as SeparationService
  rectangle "ResultService" as ResultService
}

rectangle "ML Layer" as ML {
  rectangle "AudioPreprocessor" as AudioPreprocessor
  rectangle "NeoSSNetInference\nPyTorch" as NeoSSNetInference
}

database "SQLite Database\ndatabase/cardiopulmonary.db" as SQLite {
  rectangle "uploaded_audio" as TUpload
  rectangle "model" as TModel
  rectangle "separation_job" as TJob
  rectangle "separation_result" as TResult
  rectangle "evaluation_metric" as TMetric
  rectangle "system_log" as TLog
}

folder "Local Storage" as LocalStorage {
  folder "storage/uploads/raw" as Uploads
  folder "storage/outputs/heart" as HeartOutputs
  folder "storage/outputs/lung" as LungOutputs
  folder "storage/ml_models" as ModelFiles
  folder "storage/logs" as LogFiles
}

folder "Dataset Storage\nnot runtime upload storage" as Dataset {
  folder "datasets/hls_cmds/raw" as RawDataset
  folder "datasets/hls_cmds/processed" as ProcessedDataset
  folder "datasets/hls_cmds/metadata" as MetadataDataset
}

User --> Browser
Browser --> UploadRouter : mixed WAV upload
Browser --> SeparationRouter : request separation
Browser --> ResultRouter : preview, download, history

UploadRouter --> StorageService
UploadRouter --> SQLite : insert upload metadata

SeparationRouter --> SeparationService
SeparationService --> StorageService
SeparationService --> AudioPreprocessor
SeparationService --> NeoSSNetInference
SeparationService --> SQLite : jobs, results, logs

ResultRouter --> ResultService
ResultService --> SQLite : read result/history
ResultService --> LocalStorage : resolve files

StorageService --> Uploads : save uploaded WAV
StorageService --> HeartOutputs : save heart WAV
StorageService --> LungOutputs : save lung WAV
NeoSSNetInference --> ModelFiles : load checkpoint/config
AudioPreprocessor --> Uploads : read uploaded WAV

Dataset ..> ML : training/evaluation source only

note bottom of Dataset
  Runtime inference uses uploaded files from storage/uploads/raw.
  Training data should come from datasets/hls_cmds/processed.
end note

@enduml
