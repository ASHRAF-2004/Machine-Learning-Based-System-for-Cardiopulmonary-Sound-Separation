@startuml
' Alternative 3: flow-oriented pattern interaction view.

left to right direction
skinparam shadowing false
skinparam linetype ortho

rectangle "UploadRouter\n<<Factory Client>>" as Upload #E4F7E7
rectangle "AudioValidatorFactory\n<<Creator>>" as ValidatorFactory #E4F7E7
rectangle "AudioValidator\n<<Product>>" as Validator #E4F7E7
rectangle "SeparationService\n<<Facade>>" as Facade #DCEBFF
rectangle "ModelStrategyResolver\nhelper" as Resolver #F4F6F8
rectangle "SeparationEngine\n<<Context>>" as Engine #FFF1CC
rectangle "SeparationAlgorithm\n<<Strategy>>" as Strategy #FFF1CC
rectangle "NeoSSNetStrategy\n<<ConcreteStrategy>>" as NeoSSNet #FFF1CC
rectangle "Heart + Lung WAV Outputs" as Outputs #F6F7F9

Upload --> ValidatorFactory : create(file name)
ValidatorFactory --> Validator : returns
Upload --> Facade : after upload, run separation
Facade --> Resolver : resolve model strategy
Resolver --> Strategy : returns algorithm
Facade --> Engine : create context
Engine --> Strategy : separate()
NeoSSNet ..> Strategy : implements
Strategy --> Outputs : saves outputs

@enduml
