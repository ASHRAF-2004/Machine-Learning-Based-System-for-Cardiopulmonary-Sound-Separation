@startuml
' Strategy Pattern adapted to HealthTech.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class "separation.py Router" as SeparationRouter {
  +postSeparate(audioId)
}

class SeparationService <<Context>> {
  -algorithm : SeparationAlgorithm
  +runSeparation(audioId)
  +setAlgorithm(algorithm)
}

interface SeparationAlgorithm <<Strategy>> {
  +separate(inputPath, modelConfig)
}

class NeoSSNetStrategy <<ConcreteStrategy>> {
  +separate(inputPath, modelConfig)
}

class ONNXNeoSSNetStrategy <<Future ConcreteStrategy>> {
  +separate(inputPath, modelConfig)
}

class BaselineSeparationStrategy <<Future ConcreteStrategy>> {
  +separate(inputPath, modelConfig)
}

class NeoSSNetInference {
  +loadModel(checkpointPath, configPath)
  +generateOutput(waveform)
}

SeparationRouter --> SeparationService
SeparationService o--> SeparationAlgorithm
NeoSSNetStrategy ..|> SeparationAlgorithm
ONNXNeoSSNetStrategy ..|> SeparationAlgorithm
BaselineSeparationStrategy ..|> SeparationAlgorithm
NeoSSNetStrategy --> NeoSSNetInference

note bottom
  Mapping:
  Context = SeparationService
  Strategy = SeparationAlgorithm
  Current concrete strategy = NeoSSNetStrategy
  Future strategies are optional extensions.
end note

@enduml
