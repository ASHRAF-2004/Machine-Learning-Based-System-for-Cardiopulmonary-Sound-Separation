@startuml
' Strategy Pattern adapted to the refactored backend implementation.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class "SeparationEngine" as SeparationEngine <<Context>> {
  -algorithm : SeparationAlgorithm
  +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path)
}

interface SeparationAlgorithm <<Strategy>> {
  +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path, device_name)
}

class NeoSSNetStrategy <<ConcreteStrategy>> {
  +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path, device_name)
}

SeparationEngine --> SeparationAlgorithm : delegates separation
NeoSSNetStrategy ..|> SeparationAlgorithm

note bottom
  Mapping:
  Context = SeparationEngine
  Strategy = SeparationAlgorithm
  ConcreteStrategy = NeoSSNetStrategy
end note

@enduml
