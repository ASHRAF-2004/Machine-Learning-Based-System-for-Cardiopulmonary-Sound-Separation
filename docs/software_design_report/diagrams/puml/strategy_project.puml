@startuml
' Strategy Pattern adapted to the current backend implementation.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class "SeparationService" as SeparationService <<Context>> {
  +separate_uploaded_audio(db, audio_id, model_id)
}

interface SeparationAlgorithm <<Strategy>> {
  +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path, device_name)
}

class NeoSSNetStrategy <<ConcreteStrategy>> {
  +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path, device_name)
}

SeparationService --> SeparationAlgorithm : delegates selected algorithm
NeoSSNetStrategy ..|> SeparationAlgorithm

note bottom
  Mapping:
  Context = SeparationService
  Strategy = SeparationAlgorithm
  ConcreteStrategy = NeoSSNetStrategy
end note

@enduml
