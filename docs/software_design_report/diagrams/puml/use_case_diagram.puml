@startuml
' HealthTech use case diagram.
' Suggested LaTeX placement: normal page.

left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam usecase {
  BackgroundColor #F8FBFF
  BorderColor #2D5A88
}

actor "User" as User

rectangle "HealthTech Cardiopulmonary Sound Separation System" {
  usecase "Upload Mixed Audio" as UCUpload
  usecase "Run Sound Separation" as UCSeparate
  usecase "Preview Heart and\nLung Outputs" as UCPreview
  usecase "Download Separated\nOutputs" as UCDownload
  usecase "View Processing\nHistory" as UCHistory
}

User --> UCUpload
User --> UCSeparate
User --> UCPreview
User --> UCDownload
User --> UCHistory

note right of UCSeparate
  The backend uses real separation
  and records the selected model.
end note

@enduml
