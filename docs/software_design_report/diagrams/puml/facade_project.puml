@startuml
' Facade Pattern adapted to the current backend implementation.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class SeparationRouter <<Client>> {
  +separate_audio(audio_id, model_id)
}

class SeparationService <<Facade>> {
  +separate_uploaded_audio(db, audio_id, model_id)
  +create_running_job(db, uploaded_audio_id, model_id)
  +mark_job_failed(db, job, error, processing_time_ms)
}

class ModelService <<Subsystem>> {
  +get_model_for_separation(db, model_id)
}

class StorageService <<Subsystem>> {
  +save_uploaded_wav(file)
  +read_wav_metadata(path)
  +remove_saved_file(path)
}

class ResultService <<Subsystem>> {
  +get_result_details(db, job_id)
  +get_download_file(db, job_id, output_type)
  +get_history(db, limit)
}

SeparationRouter --> SeparationService
SeparationService --> ModelService
SeparationService --> StorageService
SeparationService --> ResultService

note bottom
  Mapping:
  Client = SeparationRouter
  Facade = SeparationService
  Subsystems = ModelService, StorageService, ResultService
end note

@enduml
