@startuml
' Alternative 1: grouped colored pattern boxes.

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle

package "Facade Pattern" as F #DCEBFF {
  class "SeparationRouter" as FRouter <<Client>>
  class "SeparationService" as FService <<Facade>>
  class "ModelService" as FModel <<Subsystem>>
  class "StorageService" as FStorage <<Subsystem>>
  class "ResultService" as FResult <<Subsystem>>
}

package "Strategy Pattern" as S #FFF1CC {
  class "SeparationEngine" as SEngine <<Context>>
  interface "SeparationAlgorithm" as SAlgorithm <<Strategy>>
  class "NeoSSNetStrategy" as SNeoSSNet <<ConcreteStrategy>>
}

package "Factory Method Pattern" as M #E4F7E7 {
  class "UploadRouter" as MRouter <<Client>>
  class "AudioValidatorFactory" as MFactory <<Creator>>
  class "WavAudioValidatorFactory" as MWavFactory <<ConcreteCreator>>
  interface "AudioValidator" as MProduct <<Product>>
  class "WavAudioValidator" as MWav <<ConcreteProduct>>
}

FRouter --> FService
FService --> FModel
FService --> FStorage
FService --> FResult
FService --> SEngine
SEngine --> SAlgorithm
SNeoSSNet ..|> SAlgorithm
MRouter --> MFactory
MWavFactory --|> MFactory
MFactory ..> MProduct
MWavFactory ..> MWav
MWav ..|> MProduct

@enduml
