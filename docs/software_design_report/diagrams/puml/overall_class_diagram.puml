@startuml
' Overall UML class diagram for the refactored pattern design.
' Each class or interface appears once.

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 34
skinparam ranksep 38
skinparam ArrowFontSize 10
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BorderColor #2F3A4A
  FontStyle bold
}

package "Facade Pattern" as FacadePkg #DCEBFF {
  class SeparationRouter <<Client>> {
    +separate_audio(audio_id, model_id)
  }

  class SeparationService <<Facade>> {
    +separate_uploaded_audio(db, audio_id, model_id)
    +create_running_job(db, uploaded_audio_id, model_id)
    +mark_job_failed(db, job, error, processing_time_ms)
  }

  class ModelService <<Subsystem>> {
    +list_models(db)
    +get_model_for_separation(db, model_id)
    +get_active_model(db)
    +get_model_by_id(db, model_id)
  }

  class StorageService <<Subsystem>> {
    +save_uploaded_wav(file)
    +resolve_project_path(path)
    +build_separation_output_paths(job_id)
    +read_wav_metadata(path)
  }

  class ResultService <<Subsystem>> {
    +create_separation_result(db, job_id, inference_result)
    +get_result_details(db, job_id)
    +get_download_file(db, job_id, output_type)
    +get_history(db, limit)
  }
}

package "Strategy Pattern" as StrategyPkg #FFF1CC {
  class SeparationEngine <<Context>> {
    -algorithm : SeparationAlgorithm
    +separate(...)
  }

  interface SeparationAlgorithm <<Strategy>> {
    +separate(...)
  }

  class NeoSSNetStrategy <<ConcreteStrategy>> {
    +separate(...)
  }
}

package "Factory Method Pattern" as FactoryPkg #E4F7E7 {
  class UploadRouter <<Client>> {
    +upload_audio(file)
  }

  class AudioValidatorFactory <<Creator>> {
    +create(filename) : AudioValidator
  }

  interface AudioValidator <<Product>> {
    +validate(upload_file)
  }

  class WavAudioValidator <<ConcreteProduct>> {
    +validate(upload_file)
  }
}

package "Supporting Components" as SupportPkg #F4F6F8 {
  class ModelsRouter <<Router Module>> {
    +available_models()
  }

  class ResultsRouter <<Router Module>> {
    +result_details(job_id)
    +download_heart(job_id)
    +download_lung(job_id)
    +history(limit)
  }

  class ModelStrategyResolver <<Helper>> {
    +resolve(model) : SeparationAlgorithm
  }

  class DatabaseSession <<SQLAlchemy Session>>
}

package "SQLite Data Models" as DataPkg #EAF7EA {
  class UploadedAudio <<Entity>> {
    +uploaded_audio_id
    +original_filename
    +stored_path
    +sample_rate_hz
    +uploaded_at
  }

  class Model <<Entity>> {
    +model_id
    +model_name
    +version
    +architecture
    +checkpoint_path
    +config_path
    +is_active
  }

  class SeparationJob <<Entity>> {
    +job_id
    +uploaded_audio_id
    +model_id
    +status
    +requested_at
    +completed_at
  }

  class SeparationResult <<Entity>> {
    +result_id
    +job_id
    +heart_file_path
    +lung_file_path
    +created_at
  }

  class EvaluationMetric <<Entity>> {
    +metric_id
    +result_id
    +metric_name
    +metric_value
  }

  class SystemLog <<Entity>> {
    +log_id
    +job_id
    +log_level
    +source_component
    +message
  }
}

UploadRouter --> AudioValidatorFactory
AudioValidatorFactory ..> AudioValidator : creates
WavAudioValidator ..|> AudioValidator : implements
UploadRouter --> StorageService
UploadRouter ..> UploadedAudio

SeparationRouter --> SeparationService
SeparationService --> ModelService
SeparationService --> StorageService
SeparationService --> ResultService
SeparationService --> ModelStrategyResolver
SeparationService --> SeparationEngine
SeparationService ..> UploadedAudio
SeparationService ..> SeparationJob
SeparationService ..> SeparationResult

SeparationEngine --> SeparationAlgorithm
NeoSSNetStrategy ..|> SeparationAlgorithm : implements
ModelStrategyResolver ..> SeparationAlgorithm : resolves
ModelStrategyResolver ..> NeoSSNetStrategy

ModelsRouter --> ModelService
ResultsRouter --> ResultService
ModelService ..> Model
ResultService ..> SeparationResult
ResultService ..> SeparationJob

DatabaseSession ..> UploadedAudio
DatabaseSession ..> Model
DatabaseSession ..> SeparationJob
DatabaseSession ..> SeparationResult

SeparationJob "0..*" --> "1" UploadedAudio
SeparationJob "0..*" --> "1" Model
SeparationResult "1" --> "1" SeparationJob
EvaluationMetric "0..*" --> "1" SeparationResult
SystemLog "0..*" --> "0..1" SeparationJob

legend right
  Facade: SeparationRouter -> SeparationService -> service subsystems
  Strategy: SeparationEngine -> SeparationAlgorithm -> NeoSSNetStrategy
  Factory Method: UploadRouter -> AudioValidatorFactory -> AudioValidator
endlegend

@enduml
