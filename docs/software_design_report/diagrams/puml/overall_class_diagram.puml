@startuml
' Overall class diagram aligned with the model-selection implementation.
' Suggested LaTeX placement: landscape page.

skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle

package "Frontend" {
  class BrowserUI {
    +uploadWav()
    +selectModel(modelId)
    +requestSeparation(audioId, modelId)
    +previewOutputs()
    +loadHistory()
  }
}

package "FastAPI Routers" {
  class UploadRouter {
    +upload_audio(file)
  }

  class ModelsRouter {
    +available_models()
  }

  class SeparationRouter {
    +separate_audio(audio_id, model_id)
  }

  class ResultsRouter {
    +result_details(job_id)
    +download_heart(job_id)
    +download_lung(job_id)
    +history(limit)
  }
}

package "Service Layer" {
  class StorageService {
    +save_uploaded_wav(file)
    +read_wav_metadata(path)
  }

  class ModelService {
    +list_models(db)
    +get_model_for_separation(db, model_id)
  }

  class "SeparationService" as SeparationService <<Facade>> {
    +separate_uploaded_audio(db, audio_id, model_id)
    +create_running_job(db, uploaded_audio_id, model_id)
    +mark_job_failed(db, job, error, processing_time_ms)
  }

  class ResultService {
    +get_result_details(db, job_id)
    +get_download_file(db, job_id, output_type)
    +get_history(db, limit)
  }

  class SeparationAlgorithmFactory <<Factory>> {
    +create(model) : SeparationAlgorithm
  }
}

package "ML Layer" {
  interface SeparationAlgorithm <<Strategy>> {
    +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path, device_name)
  }

  class NeoSSNetStrategy <<ConcreteStrategy>> {
    +separate(input_wav_path, model_path, model_config_path, heart_output_path, lung_output_path, device_name)
  }

  class "run_neossnet_inference()" as NeoSSNetInference {
    +run_neossnet_inference(...)
  }
}

package "Persistence Models" {
  class UploadedAudio {
    +uploaded_audio_id
    +original_filename
    +stored_path
  }

  class Model {
    +model_id
    +model_name
    +architecture
    +checkpoint_path
    +config_path
    +is_active
  }

  class SeparationJob {
    +job_id
    +uploaded_audio_id
    +model_id
    +status
  }

  class SeparationResult {
    +result_id
    +job_id
    +heart_file_path
    +lung_file_path
  }
}

class "SQLite Database" as SQLite <<Database>>
class "Local File Storage" as FileStorage <<Storage>>

BrowserUI --> UploadRouter
BrowserUI --> ModelsRouter
BrowserUI --> SeparationRouter
BrowserUI --> ResultsRouter

UploadRouter --> StorageService
UploadRouter --> UploadedAudio
ModelsRouter --> ModelService
SeparationRouter --> SeparationService
ResultsRouter --> ResultService

SeparationService --> ModelService : select active or requested model
SeparationService --> SeparationAlgorithmFactory : create(model)
SeparationService --> SeparationAlgorithm : run selected algorithm
SeparationService --> SeparationJob : create/update
SeparationService --> SeparationResult : save output metadata
SeparationService --> FileStorage : read upload/write outputs

ModelService --> Model
SeparationAlgorithmFactory ..> SeparationAlgorithm : returns product
SeparationAlgorithmFactory ..> NeoSSNetStrategy : creates for NeoSSNet
NeoSSNetStrategy ..|> SeparationAlgorithm
NeoSSNetStrategy --> NeoSSNetInference : wraps existing function

ResultService --> SeparationJob
ResultService --> SeparationResult
ResultService --> FileStorage

UploadedAudio --> SQLite
Model --> SQLite
SeparationJob --> SQLite
SeparationResult --> SQLite

@enduml
