@startuml
' Pattern-grouped overall UML class diagram for Section 2.2.
' Classes are grouped by design pattern role, not by technical layer.

left to right direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 36
skinparam ranksep 36
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}
skinparam package {
  BorderColor #2F3A4A
  FontStyle bold
}

package "Facade Pattern" as FacadePkg #DCEBFF {
  class "SeparationService" as FacadeService <<Facade>> {
    +separate_uploaded_audio(...)
    +create_running_job(...)
    +mark_job_failed(...)
  }

  class "StorageService" as FacadeStorage <<Subsystem>> {
    +save_uploaded_wav(file)
    +build_output_paths(job_id)
  }

  class "ModelService" as FacadeModel <<Subsystem>> {
    +get_model_for_separation(...)
    +get_active_model(db)
  }

  FacadeService --> FacadeModel
  FacadeService --> FacadeStorage
}

package "Strategy Pattern" as StrategyPkg #FFF1CC {
  class "SeparationService" as StrategyContext <<Context>> {
    +separate_uploaded_audio(...)
  }

  interface "SeparationAlgorithm" as StrategyInterface <<Strategy>> {
    +separate(...)
  }

  class "NeoSSNetStrategy" as StrategyConcrete <<ConcreteStrategy>> {
    +separate(...)
  }

  StrategyContext --> StrategyInterface
  StrategyConcrete ..|> StrategyInterface
}

package "Factory Method Pattern" as FactoryPkg #E4F7E7 {
  class "SeparationService" as FactoryClient <<Client>> {
    +separate_uploaded_audio(...)
  }

  class "SeparationAlgorithmFactory" as FactoryCreator <<Creator>> {
    +create(model) : SeparationAlgorithm
  }

  interface "SeparationAlgorithm" as FactoryProduct <<Product>> {
    +separate(...)
  }

  class "NeoSSNetStrategy" as FactoryConcreteProduct <<ConcreteProduct>> {
    +separate(...)
  }

  FactoryClient --> FactoryCreator
  FactoryCreator ..> FactoryProduct
  FactoryCreator ..> FactoryConcreteProduct
  FactoryConcreteProduct ..|> FactoryProduct
}

FacadeService ..> FactoryCreator

@enduml
