@startuml
' Factory Method sequence for upload audio validation.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
skinparam sequenceMessageAlign center

actor User
participant "UploadRouter\n(Client)" as UploadRouter
participant "AudioValidatorFactory\n(Creator)" as Creator
participant "WavAudioValidatorFactory\n(ConcreteCreator)" as ConcreteCreator
participant "AudioValidator\n(Product)" as Product
participant "WavAudioValidator\n(ConcreteProduct)" as ConcreteProduct

User -> UploadRouter : Select WAV and submit upload
UploadRouter -> Creator : create_validator(filename)
Creator -> ConcreteCreator : dispatch factory method
ConcreteCreator -> ConcreteProduct : create WavAudioValidator()
ConcreteCreator --> UploadRouter : return AudioValidator
UploadRouter -> Product : validate(upload_file)
Product -> ConcreteProduct : validate WAV extension/header
UploadRouter --> User : validation accepted

note right of UploadRouter
  UploadRouter does not instantiate
  WavAudioValidator directly.
end note

@enduml
