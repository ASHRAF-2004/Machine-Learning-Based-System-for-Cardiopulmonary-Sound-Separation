@startuml
' Factory Method Pattern sequence diagram.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

participant "SeparationService\n(Client)" as Service
participant "SeparationAlgorithmFactory\n(Creator)" as Factory
participant "NeoSSNetStrategy\n(ConcreteProduct)" as NeoSSNet

Service -> Factory : create(model)

alt model.architecture == "NeoSSNet"
  Factory -> NeoSSNet : instantiate strategy
  NeoSSNet --> Factory : strategy instance
else unsupported architecture
  Factory --> Service : UnsupportedModelArchitectureError
end

Factory --> Service : NeoSSNetStrategy as SeparationAlgorithm
Service -> NeoSSNet : separate(input WAV, model paths, output paths)
NeoSSNet --> Service : heart/lung output metadata

@enduml
