@startuml
' Factory Method Pattern sequence diagram.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

participant "UploadRouter\n(Client)" as Router
participant "AudioValidatorFactory\n(Creator)" as Factory
participant "WavAudioValidatorFactory\n(ConcreteCreator)" as WavFactory
participant "AudioValidator\n(Product)" as Product
participant "WavAudioValidator\n(ConcreteProduct)" as WavValidator

Router -> Router : receive uploaded file
Router -> Factory : create_validator(file.filename)

Factory -> WavFactory : create_validator(file.filename)
WavFactory -> WavValidator : <<create>>
WavValidator --> WavFactory : validator instance
WavFactory --> Factory : validator as AudioValidator
Factory --> Router : AudioValidator
Router -> Product : validate(upload_file)
Product -> WavValidator : runtime dispatch
WavValidator --> Product : validation result
Product --> Router : valid WAV

@enduml
