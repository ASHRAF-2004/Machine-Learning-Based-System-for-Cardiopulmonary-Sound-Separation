@startuml
' Factory Method Pattern sequence diagram for algorithm selection.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

participant "SeparationService\n(Client)" as Service
participant "Model\n(SQLite Record)" as Model
participant "SeparationAlgorithmFactory\n(Creator)" as Factory
participant "SeparationAlgorithm\n(Product)" as Product
participant "NeoSSNetStrategy\n(ConcreteProduct)" as NeoSSNet
participant "SeparationEngine\n(Context)" as Engine

Service -> Model : read architecture = "NeoSSNet"
Service -> Factory : create_algorithm(model)
Factory -> Factory : lookup registry by model.architecture
Factory -> NeoSSNet : <<create>>
NeoSSNet --> Factory : strategy instance
Factory --> Service : SeparationAlgorithm
Service -> Engine : SeparationEngine(algorithm)
Service -> Engine : separate(...)
Engine -> Product : separate(...)
Product -> NeoSSNet : runtime dispatch
NeoSSNet --> Product : SeparationAlgorithmResult
Product --> Engine : heart/lung metadata
Engine --> Service : SeparationAlgorithmResult

@enduml
