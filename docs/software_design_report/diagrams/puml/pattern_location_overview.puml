@startuml
' Pattern location overview diagram.
' This optional view mirrors the clean pattern role mapping.

top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 28
skinparam ranksep 28

package "Facade Pattern" as FacadePkg #DCEBFF {
  class "SeparationRouter" as FacadeClient <<Facade Client>>
  class "SeparationService" as FacadeService <<Facade>>
  class "ModelService" as FacadeModel <<Subsystem>>
  class "StorageService" as FacadeStorage <<Subsystem>>
  class "ResultService" as FacadeResult <<Subsystem>>

  FacadeClient --> FacadeService : calls
  FacadeService --> FacadeModel
  FacadeService --> FacadeStorage
  FacadeService --> FacadeResult
}

package "Strategy Pattern" as StrategyPkg #FFF1CC {
  class "SeparationEngine" as StrategyContext <<Context>>
  interface "SeparationAlgorithm" as StrategyInterface <<Strategy>>
  class "NeoSSNetStrategy" as StrategyConcrete <<ConcreteStrategy>>

  StrategyContext --> StrategyInterface : uses
  StrategyConcrete ..|> StrategyInterface : implements
}

package "Factory Method Pattern" as FactoryPkg #E4F7E7 {
  class "UploadRouter" as FactoryClient <<Client>>
  class "AudioValidatorFactory" as FactoryCreator <<Creator>>
  class "WavAudioValidatorFactory" as FactoryConcreteCreator <<ConcreteCreator>>
  interface "AudioValidator" as FactoryProduct <<Product>>
  class "WavAudioValidator" as FactoryConcreteProduct <<ConcreteProduct>>

  FactoryClient --> FactoryCreator : requests validator
  FactoryConcreteCreator --|> FactoryCreator
  FactoryCreator ..> FactoryProduct : creates
  FactoryConcreteCreator ..> FactoryConcreteProduct : creates
  FactoryConcreteProduct ..|> FactoryProduct : implements
}

@enduml
