@startuml
' Pattern location overview diagram.
' This is not grouped by technical layer; it is grouped by design pattern.

top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 28
skinparam ranksep 28
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #2F3A4A
  ArrowColor #2F3A4A
}
skinparam package {
  BorderColor #2F3A4A
  FontStyle bold
}

package "Facade Pattern" as FacadePkg #DCEBFF {
  class "SeparationService" as FacadeService <<Facade>>
  class "StorageService" as FacadeStorage <<Subsystem>>
  class "ModelService" as FacadeModel <<Subsystem>>

  FacadeService --> FacadeModel : selects model
  FacadeService --> FacadeStorage : stores files
}

package "Strategy Pattern" as StrategyPkg #FFF1CC {
  class "SeparationService" as StrategyContext <<Context>>
  interface "SeparationAlgorithm" as StrategyInterface <<Strategy>>
  class "NeoSSNetStrategy" as StrategyConcrete <<ConcreteStrategy>>

  StrategyContext --> StrategyInterface : uses
  StrategyConcrete ..|> StrategyInterface : implements
}

package "Factory Method Pattern" as FactoryPkg #E4F7E7 {
  class "SeparationService" as FactoryClient <<Client>>
  class "SeparationAlgorithmFactory" as FactoryCreator <<Creator>>
  interface "SeparationAlgorithm" as FactoryProduct <<Product>>
  class "NeoSSNetStrategy" as FactoryConcreteProduct <<ConcreteProduct>>

  FactoryClient --> FactoryCreator : requests
  FactoryCreator ..> FactoryProduct : returns
  FactoryCreator ..> FactoryConcreteProduct : creates
  FactoryConcreteProduct ..|> FactoryProduct : implements
}

@enduml
