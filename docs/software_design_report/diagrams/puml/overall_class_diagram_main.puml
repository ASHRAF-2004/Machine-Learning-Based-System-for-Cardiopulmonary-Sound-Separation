@startuml
' Compatibility source: keep this file as a real UML class diagram too.
' The pattern-location overview now lives in pattern_location_overview.puml.

top to bottom direction
skinparam classAttributeIconSize 0
skinparam linetype ortho
skinparam shadowing false
skinparam packageStyle rectangle
skinparam nodesep 36
skinparam ranksep 42
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}

package "API Routers" {
  class UploadRouter {
    +upload_audio(file)
  }

  class SeparationRouter {
    +separate_audio(audio_id, model_id)
  }

  class ModelsRouter {
    +available_models()
  }
}

package "Application Services" {
  class SeparationService <<Facade>> {
    +separate_uploaded_audio(db, audio_id, model_id)
    +create_running_job(db, uploaded_audio_id, model_id)
    +mark_job_failed(db, job, error)
  }

  class ModelService {
    +list_models(db)
    +get_model_for_separation(db, model_id)
    +get_active_model(db)
  }

  class StorageService {
    +save_uploaded_wav(file)
    +read_wav_metadata(path)
    +build_output_paths(job_id)
  }

  class ResultService {
    +get_result_details(db, job_id)
    +get_download_file(db, job_id, output_type)
    +get_history(db, limit)
  }
}

package "ML Extension Point" {
  class SeparationAlgorithmFactory <<Creator>> {
    +create(model) : SeparationAlgorithm
  }

  interface SeparationAlgorithm <<Strategy>> {
    +separate(input_path, model_path, config_path, heart_path, lung_path)
  }

  class NeoSSNetStrategy <<ConcreteStrategy>> {
    +separate(input_path, model_path, config_path, heart_path, lung_path)
  }
}

package "SQLite Data Models" {
  class UploadedAudio {
    +uploaded_audio_id
    +original_filename
    +stored_path
    +uploaded_at
  }

  class Model {
    +model_id
    +model_name
    +architecture
    +checkpoint_path
    +config_path
    +is_active
  }

  class SeparationJob {
    +job_id
    +uploaded_audio_id
    +model_id
    +status
    +created_at
  }

  class SeparationResult {
    +result_id
    +job_id
    +heart_file_path
    +lung_file_path
  }

  class EvaluationMetric {
    +metric_id
    +result_id
    +metric_name
    +metric_value
  }

  class SystemLog {
    +log_id
    +job_id
    +level
    +message
    +created_at
  }
}

UploadRouter --> StorageService
SeparationRouter --> SeparationService
ModelsRouter --> ModelService

SeparationService --> ModelService
SeparationService --> StorageService
SeparationService --> SeparationAlgorithmFactory
SeparationService ..> SeparationAlgorithm
SeparationService ..> SeparationJob
SeparationService ..> SeparationResult
ResultService --> StorageService
ModelService ..> Model

SeparationAlgorithmFactory ..> SeparationAlgorithm
SeparationAlgorithmFactory ..> NeoSSNetStrategy
NeoSSNetStrategy ..|> SeparationAlgorithm

SeparationJob "0..*" --> "1" UploadedAudio
SeparationJob "0..*" --> "1" Model
SeparationResult "1" --> "1" SeparationJob
EvaluationMetric "0..*" --> "1" SeparationResult
SystemLog "0..*" --> "0..1" SeparationJob

@enduml
