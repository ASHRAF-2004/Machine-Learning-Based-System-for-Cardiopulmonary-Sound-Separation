@startuml
' Strategy Pattern sequence diagram.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

actor User
participant "SeparationService\n(Context)" as Service
participant "SeparationAlgorithm\n(Strategy)" as Algorithm
participant "NeoSSNetStrategy\n(ConcreteStrategy)" as NeoSSNet

User -> Service : request separation
Service -> Algorithm : separate(input paths, model paths, output paths)
Algorithm -> NeoSSNet : execute concrete strategy
NeoSSNet --> Algorithm : SeparationAlgorithmResult
Algorithm --> Service : heart/lung output metadata
Service --> User : completed job result

@enduml
