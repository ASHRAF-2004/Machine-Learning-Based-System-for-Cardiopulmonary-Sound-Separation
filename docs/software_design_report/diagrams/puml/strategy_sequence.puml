@startuml
' Strategy Pattern sequence diagram.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

participant "SeparationEngine\n(Context)" as Engine
participant "SeparationAlgorithm\n(Strategy)" as Algorithm
participant "NeoSSNetStrategy\n(ConcreteStrategy)" as NeoSSNet

Engine -> Algorithm : separate(input paths, model paths, output paths)
Algorithm -> NeoSSNet : dispatch concrete strategy
NeoSSNet --> Algorithm : SeparationAlgorithmResult
Algorithm --> Engine : heart/lung output metadata

@enduml
