@startuml
' Factory Method Pattern adapted to upload audio validation.
' Suggested LaTeX placement: normal page.

left to right direction
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 40
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  ArrowColor #333333
}

class UploadRouter <<Client>> {
  +upload_audio(file, db)
}

abstract class AudioValidatorFactory <<Creator>> {
  +create_validator(filename) : AudioValidator
}

class WavAudioValidatorFactory <<ConcreteCreator>> {
  +create_validator(filename) : AudioValidator
}

interface AudioValidator <<Product>> {
  +validate(upload_file)
}

class WavAudioValidator <<ConcreteProduct>> {
  +validate(upload_file)
}

UploadRouter --> AudioValidatorFactory : create_validator()
UploadRouter --> AudioValidator : validate()
WavAudioValidatorFactory --|> AudioValidatorFactory
AudioValidatorFactory ..> AudioValidator : returns
WavAudioValidatorFactory ..> WavAudioValidator : creates
WavAudioValidator ..|> AudioValidator

@enduml
