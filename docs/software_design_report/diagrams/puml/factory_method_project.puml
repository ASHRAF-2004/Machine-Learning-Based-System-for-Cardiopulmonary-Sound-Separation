@startuml
' Factory Method Pattern adapted to the current backend implementation.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class "SeparationService" as SeparationService <<Client>> {
  +separate_uploaded_audio(db, audio_id, model_id)
}

class SeparationAlgorithmFactory <<Creator>> {
  +create(model) : SeparationAlgorithm
}

interface SeparationAlgorithm <<Product>> {
  +separate(...)
}

class NeoSSNetStrategy <<ConcreteProduct>> {
  +separate(...)
}

SeparationService --> SeparationAlgorithmFactory : create(model)
SeparationAlgorithmFactory ..> SeparationAlgorithm : returns product
SeparationAlgorithmFactory ..> NeoSSNetStrategy : creates for architecture="NeoSSNet"
NeoSSNetStrategy ..|> SeparationAlgorithm
SeparationService --> SeparationAlgorithm : calls separate()

note bottom
  Mapping:
  Client = SeparationService
  Creator = SeparationAlgorithmFactory
  Product = SeparationAlgorithm
  ConcreteProduct = NeoSSNetStrategy
end note

@enduml
