@startuml
' Factory Method Pattern adapted to separation algorithm selection.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class SeparationService <<Client>> {
  +separate_uploaded_audio(db, audio_id, model_id)
}

class SeparationAlgorithmFactory <<Creator>> {
  +create_algorithm(model) : SeparationAlgorithm
}

class ModelStrategyResolver <<CompatibilityCreator>> {
  +create_algorithm(model) : SeparationAlgorithm
  +resolve(model) : SeparationAlgorithm
}

interface SeparationAlgorithm <<Product>> {
  +separate(...)
}

class NeoSSNetStrategy <<ConcreteProduct>> {
  +separate(...)
}

class Model <<Model Record>> {
  +architecture
  +checkpoint_path
  +config_path
}

SeparationService --> SeparationAlgorithmFactory : create_algorithm(model)
ModelStrategyResolver --|> SeparationAlgorithmFactory
SeparationAlgorithmFactory ..> Model : reads architecture
SeparationAlgorithmFactory ..> SeparationAlgorithm : creates
SeparationAlgorithmFactory ..> NeoSSNetStrategy : creates for NeoSSNet
NeoSSNetStrategy ..|> SeparationAlgorithm
SeparationService --> SeparationAlgorithm : passes to SeparationEngine

@enduml
