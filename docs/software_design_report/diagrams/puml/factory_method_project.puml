@startuml
' Factory Method Pattern adapted to upload audio validation.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class UploadRouter <<Client>> {
  +upload_audio(file)
}

class AudioValidatorFactory <<Creator>> {
  +create_validator(filename) : AudioValidator
}

class WavAudioValidatorFactory <<ConcreteCreator>> {
  +create_validator(filename) : AudioValidator
}

interface AudioValidator <<Product>> {
  +validate(upload_file)
}

class WavAudioValidator <<ConcreteProduct>> {
  +validate(upload_file)
}

UploadRouter --> AudioValidatorFactory : create_validator(file.filename)
WavAudioValidatorFactory --|> AudioValidatorFactory
AudioValidatorFactory ..> AudioValidator : creates
WavAudioValidatorFactory ..> WavAudioValidator : creates
WavAudioValidator ..|> AudioValidator
UploadRouter --> AudioValidator : validate(file)

@enduml
