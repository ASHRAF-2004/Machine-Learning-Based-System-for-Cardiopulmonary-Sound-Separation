@startuml
' Factory Method Pattern adapted to upload audio validation.
' Suggested LaTeX placement: normal page.

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class "UploadRouter" as UploadRouter <<Client>> {
  +upload_audio(file)
}

class AudioValidatorFactory <<Creator>> {
  +create(filename) : AudioValidator
}

interface AudioValidator <<Product>> {
  +validate(upload_file)
}

class WavAudioValidator <<ConcreteProduct>> {
  +validate(upload_file)
}

UploadRouter --> AudioValidatorFactory : create(file.filename)
AudioValidatorFactory ..> AudioValidator : returns product
AudioValidatorFactory ..> WavAudioValidator : creates for ".wav"
WavAudioValidator ..|> AudioValidator
UploadRouter --> AudioValidator : validate(file)

note bottom
  Mapping:
  Client = UploadRouter
  Creator = AudioValidatorFactory
  Product = AudioValidator
  ConcreteProduct = WavAudioValidator
end note

@enduml
