@startuml
' Facade Pattern sequence diagram.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

actor User
participant "API Router" as Router
participant "SeparationService\n(Facade)" as Service
participant "Audio/ML Subsystem" as ML
database "Database/Storage" as Persistence

User -> Router : POST /separate/{audio_id}?model_id=optional
Router -> Service : separate_uploaded_audio(db, audio_id, model_id)

Service -> Persistence : read upload/model and create job
Persistence --> Service : input path, model paths, job id
Service -> ML : run selected separation algorithm
ML --> Service : heart and lung output files
Service -> Persistence : save result metadata and status
Service --> Router : completed job result
Router --> User : preview/download response

@enduml
