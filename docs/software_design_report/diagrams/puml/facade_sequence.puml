@startuml
' Facade Pattern sequence diagram.
' Suggested LaTeX placement: normal page.

skinparam shadowing false
autonumber

actor User
participant "API Router" as Router
participant "SeparationService\n(Facade)" as Service
participant "Audio/ML Subsystem" as ML
database "Database/Storage" as Persistence

User -> Router : POST /separate/{audio_id}?model_id=optional
Router -> Service : separate_uploaded_audio(db, audio_id, model_id)

Service -> Persistence : read upload and selected/active model
Persistence --> Service : stored_path and model paths
Service -> Persistence : create running separation_job
Persistence --> Service : job_id

Service -> ML : separate(input WAV, model paths)
ML --> Service : heart WAV path and lung WAV path

Service -> Persistence : save result metadata and completed status
Service --> Router : job status and output paths
Router --> User : JSON response for preview/download

alt error
  Service -> Persistence : mark job failed
  Service --> Router : raise service error
  Router --> User : error response
end

@enduml
