# =========================
# Application
# =========================
APP_NAME="Cardiopulmonary Sound Separation System"
APP_ENV="development"
DEBUG=true

# =========================
# Server
# =========================
HOST="127.0.0.1"
PORT=8000

# =========================
# Database
# =========================
DATABASE_URL="sqlite:///database/cardiopulmonary.db"

# =========================
# Storage Paths
# =========================
UPLOAD_DIR="storage/uploads/raw"
TEMP_UPLOAD_DIR="storage/uploads/temp"
HEART_OUTPUT_DIR="storage/outputs/heart"
LUNG_OUTPUT_DIR="storage/outputs/lung"
LOG_DIR="storage/logs"

# =========================
# Model Paths
# =========================
MODEL_DIR="storage/ml_models"
DEFAULT_MODEL_NAME="NeoSSNet"
DEFAULT_MODEL_CHECKPOINT="storage/ml_models/model_best.pt"
DEFAULT_MODEL_CONFIG="storage/ml_models/model.yaml"

# =========================
# Audio Settings
# =========================
ALLOWED_AUDIO_EXTENSIONS=".wav"
DEFAULT_SAMPLE_RATE=4000
MAX_UPLOAD_SIZE_MB=50

# =========================
# Security / Demo
# =========================
# Change this if you later add authentication or sessions.
SECRET_KEY="change-this-secret-key-before-production"